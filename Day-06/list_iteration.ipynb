   "source": [
    "# Iterating Through Lists\n",
    "\n",
    "names = [\"Alice\", \"Bob\", \"Charlie\"]\n",
    "\n",
    "# Using a for loop\n",
    "for name in names:\n",
    "    print(f\"Hello, {name}!\")\n",
    "\n",
    "# Using a for loop with index\n",
    "for i in range(len(names)):\n",
    "    print(f\"Index {i}: {names[i]}\")"
   ]
  }
