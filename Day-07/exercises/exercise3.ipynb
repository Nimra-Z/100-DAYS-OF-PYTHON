   "source": [
    "# Exercise 3: Set Operations\n",
    "set1 = {1, 2, 3}\n",
    "set2 = {3, 4, 5}\n",
    "\n",
    "print(\"Set1:\", set1)\n",
    "print(\"Set2:\", set2)\n",
    "print(\"Union:\", set1 | set2)\n",
    "print(\"Intersection:\", set1 & set2)\n",
    "print(\"Difference (Set1 - Set2):\", set1 - set2)\n",
    "print(\"Symmetric Difference:\", set1 ^ set2)"
   ]
  }
