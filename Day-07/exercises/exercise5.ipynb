    "# Exercise 5: Adding Duplicates to a Set\n",
    "my_set = {1, 2, 3}\n",
    "print(\"Original Set:\", my_set)\n",
    "\n",
    "# Adding duplicates\n",
    "my_set.add(2)\n",
    "my_set.add(3)\n",
    "print(\"After adding duplicates:\", my_set)\n",
    "\n",
    "# Adding a new element\n",
    "my_set.add(4)\n",
    "print(\"After adding 4:\", my_set)"
   ]
