   "source": [
    "# Exercise 1: Create and Modify a Dictionary\n",
    "\n",
    "person = {\n",
    "    \"name\": \"Alice\",\n",
    "    \"age\": 25,\n",
    "    \"city\": \"New York\"\n",
    "}\n",
    "\n",
    "# Add a new key\n",
    "person[\"gender\"] = \"Female\"\n",
    "\n",
    "# Update the age\n",
    "person[\"age\"] = 26\n",
    "\n",
    "# Remove the city\n",
    "del person[\"city\"]\n",
    "\n",
    "print(person)"
   ]
